# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# [Linux] KVM/libvirt 환경
# 사전 요구사항:
#   sudo apt install -y qemu-kvm libvirt-daemon-system libvirt-clients
#   vagrant plugin install vagrant-libvirt
#   sudo usermod -aG libvirt,kvm $USER  (재로그인 필요)
#
# 리소스 합계: CPU 4코어, RAM 5GB

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_check_update = false

  nodes = [
    { name: "master",   ip: "192.168.121.10", cpu: 2, mem: 2048 },
    { name: "worker-1", ip: "192.168.121.11", cpu: 1, mem: 1536 },
    { name: "worker-2", ip: "192.168.121.12", cpu: 1, mem: 1536 },
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |vm_config|
      vm_config.vm.hostname = node[:name]
      vm_config.vm.network "private_network", ip: node[:ip]

      vm_config.vm.provider "libvirt" do |lv|
        lv.driver = "kvm"
        lv.cpus   = node[:cpu]
        lv.memory = node[:mem]
      end

      vm_config.vm.provision "shell", inline: <<-SHELL
        if ! id -u ubuntu &>/dev/null; then
          useradd -m -s /bin/bash ubuntu
        fi
        echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ubuntu
        mkdir -p /home/ubuntu/.ssh
        cp /home/vagrant/.ssh/authorized_keys /home/ubuntu/.ssh/authorized_keys
        chown -R ubuntu:ubuntu /home/ubuntu/.ssh
        chmod 700 /home/ubuntu/.ssh
        chmod 600 /home/ubuntu/.ssh/authorized_keys
      SHELL
    end
  end
end
